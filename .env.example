# Generate a token: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Replace each key with a generated token; tokens map to server-controlled user IDs.
API_TOKENS_JSON={"replace-with-a-random-token":"demo-user"}
DEEPSEEK_API_KEY=
# Fill with an available model ID from your provider console.
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DATA_DIR=./data
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
