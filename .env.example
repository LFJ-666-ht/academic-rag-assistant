# Required: generate a private token and replace the empty map before starting.
# python -c "import secrets,json; print('API_TOKENS_JSON=' + json.dumps({secrets.token_urlsafe(32): 'demo-user'}))"
# Tokens map to server-controlled user IDs. Keep user IDs stable when migrating data.
API_TOKENS_JSON={}
DEEPSEEK_API_KEY=
# Fill with an available model ID from your provider console.
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Auto selects the code preset for known Ark model IDs (261017: 393216 / max).
# This preset is not a verified provider limit; confirm current account/model support.
# Other unrecognized models use provider defaults; enter supported explicit values if needed.
# This is an output budget (reasoning + answer), not a target answer length.
DEEPSEEK_MAX_TOKENS=auto
DEEPSEEK_TOKEN_PARAMETER=max_tokens
DEEPSEEK_REASONING_EFFORT=auto
DEEPSEEK_THINKING=auto
DEEPSEEK_TIMEOUT_SECONDS=300
DEEPSEEK_TOTAL_TIMEOUT_SECONDS=7200
DEEPSEEK_IMAGE_PROMPT_MAX_TOKENS=4096
# Optional image generation: enable the model in your Volcengine Ark account first.
# Keep DEEPSEEK_* for text; SEEDREAM_* is a separate provider configuration.
SEEDREAM_API_KEY=
SEEDREAM_MODEL=doubao-seedream-4-0-20260415
SEEDREAM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DATA_DIR=./data
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
# Offline use: change model names above to downloaded local model directories.
# Optional mirror, only if appropriate for your environment:
# HF_ENDPOINT=https://hf-mirror.com
# Optional cache root for downloading AND loading models; keep this path consistent.
# SENTENCE_TRANSFORMERS_HOME=./model_cache
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
